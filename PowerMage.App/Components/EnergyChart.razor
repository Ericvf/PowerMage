@using System.Globalization

<h4>@Math.Round(TotalPowerImportKwh, 2) Kwh</h4>
<h6>@Device?.DisplayName</h6>
<div class="energy-chart">
    <div class="chart-plot">
        <svg class="energy-chart-svg"
             viewBox="0 0 1440 360"
             preserveAspectRatio="none"
             aria-hidden="true">

            <g class="grid">

                @for (var watt = 0; watt <= MaxWatts; watt += 25)
                {
                    var y = Y(watt);

                    <line x1="@ChartLeft"
                          y1="@y"
                          x2="@ChartRight"
                          y2="@y"
                          class="horizontal-grid" />
                }

                @for (var minute = 0; minute <= MinutesPerDay; minute += 5)
                {
                    var x = X(minute);

                    <line x1="@x"
                          y1="@ChartTop"
                          x2="@x"
                          y2="@ChartBottom"
                          class="@(minute % 60 == 0 ? "hour-grid" : "minute-grid")" />
                }

            </g>

            <line class="axis"
                  x1="@ChartLeft"
                  y1="@ChartBottom"
                  x2="@ChartRight"
                  y2="@ChartBottom" />

            <line class="axis"
                  x1="@ChartLeft"
                  y1="@ChartTop"
                  x2="@ChartLeft"
                  y2="@ChartBottom" />

            <g class="data">

                <defs>
                    <linearGradient id="power-fill"
                                    x1="0"
                                    y1="0"
                                    x2="0"
                                    y2="1">
                        <stop offset="0%"
                              stop-color="rgb(177, 0, 255)"
                              stop-opacity="0.75" />

                        <stop offset="100%"
                              stop-color="#200058"
                              stop-opacity="0.25" />
                    </linearGradient>
                </defs>

                @foreach (var segment in GetSegments())
                {
                    if (segment.Count >= 2)
                    {
                        <path d="@BuildFilledPath(segment)"
                              class="power-fill" />

                        <path d="@BuildSmoothPath(segment)"
                              class="power-line" />
                    }
                    else if (segment.Count == 1)
                    {
                        var point = segment[0];

                        <circle cx="@X(point.Minute)"
                                cy="@Y(point.Watts)"
                                r="3"
                                class="power-point" />
                    }
                }

            </g>

        </svg>

        <div class="x-labels">
            @for (var minute = 0; minute < MinutesPerDay; minute += 120)
            {
                var percentage = ChartXPercentage(minute);

                <span style="left: @(percentage.ToString("0.###", CultureInfo.InvariantCulture))%">
                    @TimeLabel(minute)
                </span>
            }
        </div>
    </div>


    <div class="y-labels">
        @for (var watt = 0; watt <= MaxWatts; watt += (int)YAxisStep)
        {
            var percentage = ChartYPercentage(watt);

            <span style="top: @(percentage.ToString("0.###", CultureInfo.InvariantCulture))%">
                @watt W
            </span>
        }
    </div>

</div>


<style>
    h4, h6{
        margin:0;
    }
    h4{
        color: rgb(177, 0, 255);
    }
    h6{
        color: white;
        font-size:0.8em;
    }
    .energy-chart {
        position: relative;
        display: grid;
        /*
             * This column NEVER changes width.
             */
        grid-template-columns: 50px minmax(0, 1fr);
        /* width: 100%; */
        height: 300px;
        background:black;
        border-color: var(--pico-muted-border-color);
        border-radius: 5px;
        margin: 10px;
    }


    /*
         * Only this part is responsive.
         */
    .chart-plot {
        position: relative;
        min-width: 0;
        height: 100%;
    }


    .energy-chart-svg {
        position: absolute;
        inset: 0;
        display: block;
        width: 100%;
        height: 100%;
        overflow: visible;
    }


    /* ------------------------------------------------------------
           Grid
           ------------------------------------------------------------ */

    .minute-grid {
        stroke: var(--pico-muted-border-color);
        stroke-width: 1;
        opacity: 0.18;
        /* vector-effect: non-scaling-stroke; */
    }

    .hour-grid {
        stroke: var(--pico-muted-border-color);
        stroke-width: 1;
        opacity: 0.55;
        vector-effect: non-scaling-stroke;
    }

    .horizontal-grid {
        stroke: var(--pico-muted-border-color);
        stroke-width: 1;
        opacity: 0.5;
        vector-effect: non-scaling-stroke;
    }


    /* ------------------------------------------------------------
           Axes
           ------------------------------------------------------------ */

    .axis {
        stroke: var(--pico-contrast);
        stroke-width: 1;
        vector-effect: non-scaling-stroke;
    }


    /* ------------------------------------------------------------
           Line
           ------------------------------------------------------------ */

    .power-line {
        fill: none;
        stroke: rgb(177, 0, 255);
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
        vector-effect: non-scaling-stroke;
    }

    .power-fill {
        fill: url(#power-fill);
        stroke: none;
    }

    .power-point {
        fill: var(--pico-primary);
    }


    /* ------------------------------------------------------------
           Y labels
           ------------------------------------------------------------ */

    .y-labels {
        position: relative;
        grid-column: 1;
        grid-row: 1;
        pointer-events: none;
        color: var(--pico-muted-color);
        font-size: 12px;
    }

        .y-labels span {
            position: absolute;
            /*
             * Y percentage is relative to the entire 360px
             * chart height, not the width.
             */
            left: 0;
            transform: translateY(-50%);
            white-space: nowrap;
            padding-left: 5px;
        }


    /* ------------------------------------------------------------
           X labels
           ------------------------------------------------------------ */

    .x-labels {
        position: absolute;
        inset: 0;
        pointer-events: none;
        color: var(--pico-muted-color);
        font-size: 12px;
    }

        .x-labels span {
            position: absolute;
            bottom: 15px;
            white-space: nowrap;
        }

</style>


@code {

    [Parameter, EditorRequired]
    public DateTime Day { get; set; }

    [Parameter, EditorRequired]
    public DeviceModel? Device { get; set; }

    [Parameter, EditorRequired]
    public double TotalPowerImportKwh { get; set; }

    [Parameter, EditorRequired]
    public IEnumerable<DeviceEnergyAggregate> Data { get; set; }
        = Array.Empty<DeviceEnergyAggregate>();


    // Math.Max(200,  + 200) / 200) * 200);
    private double MaxWatts =>
        Data.Where(x => x.AvgActivePowerW.HasValue)
            .Select(x => x.AvgActivePowerW!.Value)
            .DefaultIfEmpty(0)
            .Max();

    private double YAxisStep => Math.Round(Math.Ceiling(MaxWatts / 10) / 5) * 5;

    private const int MinutesPerDay = 1440;

    /*
     * SVG coordinate system.
     *
     * Left side is reserved for Y labels.
     * Bottom is reserved for X labels.
     */
    private const double ChartLeft = 0;

    private const double ChartRight = 1425;

    private const double ChartTop = 15;

    private const double ChartBottom = 310;


    private double X(double minute)
    {
        return ChartLeft +
               (minute / MinutesPerDay) *
               (ChartRight - ChartLeft);
    }


    private double Y(double watts)
    {
        watts = Math.Clamp(watts, 0, MaxWatts);

        return ChartBottom -
               (watts / MaxWatts) *
               (ChartBottom - ChartTop);
    }


    /*
     * Percentage positions for the HTML labels.
     *
     * These must use the same chart area as the SVG.
     */
    private double ChartXPercentage(double minute)
    {
        return X(minute) / 1440.0 * 100.0;
    }


    private double ChartYPercentage(double watts)
    {
        return Y(watts) / 360.0 * 100.0;
    }


    private string TimeLabel(int minute)
    {
        var time = TimeSpan.FromMinutes(minute);

        return $"{(int)time.TotalHours:00}:{time.Minutes:00}";
    }


    private List<List<ChartPoint>> GetSegments()
    {
        var dayStartUnix =
            new DateTimeOffset(Day).ToUnixTimeSeconds();

        var dayEndUnix =
            dayStartUnix + 86400;


        var points = Data

            .Where(x =>
                x.AvgActivePowerW.HasValue &&
                x.IntervalStartUnix >= dayStartUnix &&
                x.IntervalStartUnix < dayEndUnix)

            .Select(x =>
            {
                var minute =
                    (x.IntervalStartUnix - dayStartUnix) / 60.0;

                return new ChartPoint(
                    minute,
                    x.AvgActivePowerW!.Value);
            })

            .OrderBy(x => x.Minute)

            .ToList();


        var segments = new List<List<ChartPoint>>();


        if (points.Count == 0)
            return segments;


        var current = new List<ChartPoint>();


        foreach (var point in points)
        {
            if (current.Count == 0)
            {
                current.Add(point);
                continue;
            }


            var previous = current[^1];


            /*
             * A normal interval is 5 minutes.
             *
             * If the next point is more than 5 minutes away,
             * stop the current path.
             */
            if (point.Minute - previous.Minute > 5.01)
            {
                segments.Add(current);

                current = new List<ChartPoint>();
            }


            current.Add(point);
        }


        if (current.Count > 0)
            segments.Add(current);


        return segments;
    }
    private string BuildFilledPath(List<ChartPoint> points)
{
    if (points.Count < 2)
        return string.Empty;

    var line = BuildSmoothPath(points);

    var firstX = X(points[0].Minute);
    var lastX = X(points[^1].Minute);

    return $"{line} " +
           $"L {F(lastX)} {F(ChartBottom)} " +
           $"L {F(firstX)} {F(ChartBottom)} Z";
}

    private string BuildSmoothPath(List<ChartPoint> points)
    {
        if (points.Count < 2)
            return string.Empty;


        var path = new System.Text.StringBuilder();


        var first = points[0];


        path.Append(
            $"M {F(X(first.Minute))} {F(Y(first.Watts))}");


        for (var i = 0; i < points.Count - 1; i++)
        {
            var p0 = i > 0
                ? points[i - 1]
                : points[i];

            var p1 = points[i];

            var p2 = points[i + 1];

            var p3 = i + 2 < points.Count
                ? points[i + 2]
                : p2;


            /*
             * Catmull-Rom -> cubic Bézier.
             *
             * This gives us a smooth curve while keeping
             * the curve passing through the actual data points.
             */
            var cp1X =
                p1.Minute +
                (p2.Minute - p0.Minute) / 6.0;

            var cp1Y =
                p1.Watts +
                (p2.Watts - p0.Watts) / 6.0;


            var cp2X =
                p2.Minute -
                (p3.Minute - p1.Minute) / 6.0;

            var cp2Y =
                p2.Watts -
                (p3.Watts - p1.Watts) / 6.0;


            path.Append(
                $" C " +
                $"{F(X(cp1X))} {F(Y(cp1Y))}, " +
                $"{F(X(cp2X))} {F(Y(cp2Y))}, " +
                $"{F(X(p2.Minute))} {F(Y(p2.Watts))}");
        }


        return path.ToString();
    }


    private static string F(double value)
    {
        return value.ToString(
            "0.##",
            CultureInfo.InvariantCulture);
    }


    private record ChartPoint(
        double Minute,
        double Watts);
}