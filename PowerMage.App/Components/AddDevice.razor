@using System.ComponentModel.DataAnnotations
@using PowerMage.Components.Charts
@implements IDisposable

@inject IHomewizardDiscovery Discovery
@inject DeviceRepository deviceRepository

<section id="tables">
    <h2>Devices</h2>
    <div class="overflow-auto">
        <table class="striped">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Serial</th>
                    <th scope="col">Product Type</th>
                    <th scope="col">Product Name</th>
                    <th scope="col">Display Name</th>
                    <th scope="col">IP Address</th>
                    <th class="small" />
                    <th class="small" />
                </tr>
            </thead>
            <tbody>
                @{
                    var existingDeviceArray = existingDevices.ToArray();
                    var total = existingDeviceArray.Length;

                    for (int i = 0; i < total; i++)
                    {
                        var prevDevice = i > 0 ? existingDeviceArray[i - 1] : null;
                        var device = existingDeviceArray[i];
                        var nextDevice = i < total - 1 ? existingDeviceArray[i + 1] : null;
                        <tr>
                            <td>@device.Order</td>
                            <td>@device.Serial</td>
                            <td>@device.ProductType</td>
                            <td>@device.ProductName</td>
                            <td>@device.DisplayName</td>
                            <td>@device.IpAddress</td>
                            <td class="small">
                                @if (i > 0)
                                {
                                    <button class="small" @onclick="() => MoveDeviceUp(device, prevDevice)">
                                        <ArrowUp />
                                    </button>
                                }

                            </td>
                            <td class="small">
                                @if (i < total - 1)
                                {
                                    <button class="small" @onclick="() => MoveDeviceDown(device, nextDevice)">
                                        <ArrowDown />
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <button class="secondary small" data-target="form-dialog" onclick="toggleModal(event)">
        ➕ Add new device
    </button>
</section>

<dialog id="form-dialog">
    <article>
        <header>
            <button aria-label="Close"
                    rel="prev"
                    data-target="form-dialog"
                    onclick="toggleModal(event)"></button>
            <h3>Add Device</h3>
        </header>

        <EditForm Model="newDevice" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <InputSelect @bind-Value="newDevice.DeviceId" @bind-Value:after="OnDeviceChanged">
                <option selected disabled value="">
                    Select a device...
                </option>
                @foreach (var device in devices.Where(d => d.ApiEnabled))
                {
                    <option value="@device.Serial">[@device.Serial] @device.ProductType (@device.Addresses.FirstOrDefault()?.ToString())</option>
                }
            </InputSelect>

            <div class="form-row">
                <label>
                    Serial
                    <InputText @bind-Value="newDevice.Serial" />
                </label>
                <label>
                    ProductType
                    <InputText @bind-Value="newDevice.ProductType" />
                </label>
            </div>
            <div class="form-row">
                <label>
                    ProductName
                    <InputText @bind-Value="newDevice.ProductName" />
                </label>
                <label>
                    DisplayName
                    <InputText @bind-Value="newDevice.DisplayName" />
                </label>
            </div>
            <label>
                IpAddress
                <InputText @bind-Value="newDevice.IpAddress" />
            </label>

            <button type="submit">
                ➕ Add device
            </button>
        </EditForm>
    </article>
</dialog>

@code {
    private readonly List<HomeWizardDevice> devices = [];
    private IEnumerable<DeviceModel> existingDevices = new List<DeviceModel>();
    private CancellationTokenSource? cancellationTokenSource;
    private NewDeviceModel newDevice = new();

    public class NewDeviceModel
    {
        public int Id { get; set; }

        public string? DeviceId { get; set; }

        public string Serial { get; set; } = "";

        public string ProductType { get; set; } = "";

        public string ProductName { get; set; } = "";

        [Required(ErrorMessage = "DisplayName is required")]
        [StringLength(200, MinimumLength = 1, ErrorMessage = "DisplayName must be between 1 and 200 characters")]
        public string DisplayName { get; set; } = "";

        [Required(ErrorMessage = "Ip Address is required")]
        [StringLength(200, MinimumLength = 1, ErrorMessage = "Ip Address must be between 1 and 200 characters")]
        public string IpAddress { get; set; } = "";

    }

    private async Task Submit()
    {
        await deviceRepository.AddDevice(new DeviceModel()
        {
            Serial = newDevice.Serial,
            ProductType = newDevice.ProductType,
            ProductName = newDevice.ProductName,
            DisplayName = newDevice.DisplayName,
            IpAddress = newDevice.IpAddress,
            Track = 1,
            Order = existingDevices.Count() + 1
        });

        var deviceToRemove = devices.FirstOrDefault(d => d.Serial.Equals(newDevice.Serial, StringComparison.OrdinalIgnoreCase));
        if (deviceToRemove != null)
        {
            devices.Remove(deviceToRemove);
        }

        newDevice = new NewDeviceModel();
        existingDevices = await deviceRepository.GetDevices();

        StateHasChanged();
    }

    protected async override void OnInitialized()
    {
        existingDevices = await deviceRepository.GetDevices();

        Discovery.DeviceDiscovered += OnDeviceDiscovered;

        cancellationTokenSource = new CancellationTokenSource();

        _ = Discovery.Discover(cancellationTokenSource.Token);
    }

    private void OnDeviceDiscovered(object? sender, HomeWizardDevice device)
    {
        _ = InvokeAsync(() =>
        {
            if (existingDevices.Any(d => d.Serial.Equals(device.Serial, StringComparison.OrdinalIgnoreCase)))
                return;

            var existingIndex =
                devices.FindIndex(
                    x => x.Serial.Equals(
                        device.Serial,
                        StringComparison.OrdinalIgnoreCase));

            if (existingIndex >= 0)
                devices[existingIndex] = device;
            else
                devices.Add(device);

            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Discovery.DeviceDiscovered -= OnDeviceDiscovered;

        cancellationTokenSource?.Cancel();
        cancellationTokenSource?.Dispose();
    }

    private void OnDeviceChanged()
    {
        if (newDevice.DeviceId != null)
        {
            var device = devices.FirstOrDefault(d => d.Serial == newDevice.DeviceId);
            if (device != null)
            {
                newDevice.Serial = device.Serial;
                newDevice.ProductType = device.ProductType;
                newDevice.ProductName = device.ProductName;
                newDevice.IpAddress = device.Addresses.FirstOrDefault()?.ToString() ?? string.Empty;
            }
        }
    }

    private async Task MoveDeviceUp(DeviceModel device, DeviceModel prevDevice)
    {
        await deviceRepository.UpdateDeviceOrder(device.Id, prevDevice.Order, prevDevice.Id, device.Order);
        existingDevices = await deviceRepository.GetDevices();
        StateHasChanged();
    }

    private async Task MoveDeviceDown(DeviceModel device, DeviceModel nextDevice)
    {
        await deviceRepository.UpdateDeviceOrder(device.Id, nextDevice.Order, nextDevice.Id, device.Order);
        existingDevices = await deviceRepository.GetDevices();
        StateHasChanged();
    }
}
