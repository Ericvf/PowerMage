@inherits ChartBase
@inject DeviceRepository deviceRepository

<div class="chartblock">
    <div class="title">
        <span class="import-color">
            <ArrowDown />
            @Math.Round(totalPowerImportKwh, 2) <span class="small">Kwh</span>
        </span>
    </div>
    <h6>@Device?.DisplayName</h6>

    @if (isLoading)
    {
        <p>Loading...</p>
    }
    else
    {
        <EnergyChart Day="Day" GetChartPoints="GetChartPoints" MomentsPerView="momentsPerView" XLabelFormat="@labelFormat" />
    }
</div>

@code {
    private IEnumerable<DeviceSKTEnergyAggregate> chartData = [];
    private double totalPowerImportKwh = 0;
    private bool isLoading = true;
    private DateTime to;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            if (Device is null)
            {
                chartData = [];
                totalPowerImportKwh = 0;
                return;
            }

            to = Day.Date == DateTime.Today
              ? DateTime.UtcNow
              : Day.AddDays(daysPerView);

            if (View != Views.Day)
            {
                chartData = await deviceRepository.GetSKTDeviceEnergyKwhAggregates(Device.Id, Day, to, timeUnit);
            }
            else
            {
                chartData = await deviceRepository.GetSKTDeviceEnergyAggregates(Device.Id, Day, to, timeUnit);
            }

            totalPowerImportKwh = await deviceRepository.GetTotalPowerSKT(Device.Id, Day, to);
        }
        finally
        {
            isLoading = false;
        }
    }


    private ChartSeries[] GetChartPoints()
    {
        var startUnix = new DateTimeOffset(Day).ToUnixTimeSeconds();
        var endUnix = new DateTimeOffset(to).ToUnixTimeSeconds();

        var chartPoints = chartData
            .Where(x =>
                x.AvgActivePowerW.HasValue &&
                x.IntervalStartUnix >= startUnix &&
                x.IntervalStartUnix < endUnix)
            .Select(x => new ChartPoint((x.IntervalStartUnix - startUnix) / timeUnit, x.AvgActivePowerW!.Value, x.IntervalStartUnix))
            .OrderBy(x => x.Minute)
            .ToArray();
        var chartType = View == Views.Day ? ChartTypes.Line : ChartTypes.Bar;
        var series = new ChartSeries(chartType, chartPoints, "power", "W");
        return [series];
    }
}
