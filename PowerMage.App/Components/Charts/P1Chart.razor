@inherits ChartBase
@implements IDisposable
@inject DeviceRepository deviceRepository

<div class="chartblock">
    <div class="title">
        <span class="import-color">
            <ArrowDown />
            @Math.Round(totalPowerImportKwh, 2) <span class="small">Kwh</span>
        </span>
        <span class="export-color">
            <ArrowUp />
            @Math.Round(totalPowerExportKwh, 2) <span class="small">Kwh</span>
        </span>
        @if (isLoading)
        {
            <span aria-busy="true" class="chart-loader"></span>
        }
    </div>
    <h6>@Device?.DisplayName</h6>

    <EnergyChart Day="Day" GetChartPoints="GetChartPoints" MomentsPerView="momentsPerView" XLabelFormat="@labelFormat" />
</div>

@code {
    private readonly PeriodicTimer periodicTimer = new(TimeSpan.FromSeconds(30));
    private IEnumerable<DeviceP1EnergyAggregate> chartData = [];
    private IEnumerable<DeviceP1EnergyAggregateImportExport> chartData2 = [];
    private IEnumerable<EnphaseEnergyAggregate> enphaseData = [];
    private double totalPowerImportKwh = 0;
    private double totalPowerExportKwh = 0;
    private bool isLoading = true;
    private DateTime to;

    protected override void OnInitialized()
    {
        RunTimer();
    }

    protected override async Task OnParametersSetAsync()
    {
        await RefreshData();
    }

    protected async void RunTimer()
    {
        while (await periodicTimer.WaitForNextTickAsync())
        {
            await RefreshData();
        }
    }

    private async Task RefreshData()
    {
        try
        {
            if (Device is null)
            {
                chartData = [];
                totalPowerImportKwh = 0;
                totalPowerExportKwh = 0;
                return;
            }

            isLoading = true;
            await InvokeAsync(StateHasChanged);

            to = Day.Date == DateTime.Today
                ? DateTime.UtcNow
                : Day.AddDays(daysPerView);

            var totalPowerImportKwhTask = deviceRepository.GetTotalP1(Device.Id, Day, to);
            var totalPowerExportKwhTask = deviceRepository.GetTotalExportP1(Device.Id, Day, to);

            await Task.WhenAll(totalPowerImportKwhTask, totalPowerExportKwhTask);

            if (View != Views.Day)
            {
                chartData2 = await deviceRepository.GetDeviceP1EnergyAggregatesImportExport(Device.Id, Day, to, timeUnit);
            }
            else
            {
                chartData = await deviceRepository.GetDeviceP1EnergyAggregates(Device.Id, Day, to, timeUnit);
                enphaseData = await deviceRepository.GetEnphaseEnergyAggregates(Day, to, timeUnit);
            }

            totalPowerImportKwh = await totalPowerImportKwhTask;
            totalPowerExportKwh = await totalPowerExportKwhTask;
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private ChartSeries[] GetChartPoints()
    {
        var startUnix = new DateTimeOffset(Day).ToUnixTimeSeconds();
        var endUnix = new DateTimeOffset(to).ToUnixTimeSeconds();

        if (View != Views.Day)
        {
            var importChartData = chartData2
                                    .Where(x =>
                                        x.ImportKwh.HasValue &&
                                        x.IntervalStartUnix >= startUnix &&
                                        x.IntervalStartUnix < endUnix)
                                    .Select(x => new ChartPoint((x.IntervalStartUnix - startUnix) / timeUnit, x.ImportKwh!.Value, x.IntervalStartUnix))
                                    .OrderBy(x => x.Minute)
                                    .ToArray();

            var importSeries = new ChartSeries(ChartTypes.Bar, importChartData, "power", "Kwh");

            var exportChartData = chartData2
                        .Where(x =>
                            x.ExportKwh.HasValue &&
                            x.IntervalStartUnix >= startUnix &&
                            x.IntervalStartUnix < endUnix)
                        .Select(x => new ChartPoint((x.IntervalStartUnix - startUnix) / timeUnit, x.ExportKwh!.Value, x.IntervalStartUnix))
                        .OrderBy(x => x.Minute)
                        .ToArray();
            var exportSeries = new ChartSeries(ChartTypes.Bar, exportChartData, "powerexport", "Kwh");

            return [importSeries, exportSeries];
        }
        else
        {
            var chartPoints = chartData
                        .Where(x =>
                            x.AvgActivePowerW.HasValue &&
                            x.IntervalStartUnix >= startUnix &&
                            x.IntervalStartUnix < endUnix)
                        .Select(x => new ChartPoint((x.IntervalStartUnix - startUnix) / timeUnit, x.AvgActivePowerW!.Value, x.IntervalStartUnix))
                        .OrderBy(x => x.Minute)
                        .ToArray();

            var series = new ChartSeries(ChartTypes.Line, chartPoints, "power", "W");

            if (enphaseData != null)
            {
                var enphasePoints1 = enphaseData
                    .Where(x =>
                        x.ProductionPowerW.HasValue &&
                        x.IntervalStartUnix >= startUnix &&
                        x.IntervalStartUnix < endUnix)
                    .Select(x => new ChartPoint((x.IntervalStartUnix - startUnix) / timeUnit, -x.ProductionPowerW!.Value, x.IntervalStartUnix))
                    .OrderBy(x => x.Minute)
                    .ToArray();

                var enphasePoints2 = enphaseData
                     .Where(x =>
                         x.ConsumptionPowerW.HasValue &&
                         x.IntervalStartUnix >= startUnix &&
                         x.IntervalStartUnix < endUnix)
                     .Select(x => new ChartPoint((x.IntervalStartUnix - startUnix) / timeUnit, x.ConsumptionPowerW!.Value, x.IntervalStartUnix))
                     .OrderBy(x => x.Minute)
                     .ToArray();

                var series1 = new ChartSeries(ChartTypes.Line, enphasePoints1, "production", "W");
                var series2 = new ChartSeries(ChartTypes.Line, enphasePoints2, "consumption", "W");

                return [series1, series2, series];
            }

            return [series];
        }
    }

    public void Dispose()
    {
        Dispose(true);
        GC.SuppressFinalize(this);
    }

    protected virtual void Dispose(bool disposing)
    {
        if (disposing)
        {
            periodicTimer.Dispose();
        }
    }
}
