@inherits ChartBase
@inject DeviceRepository deviceRepository

<div class="chartblock">
    <div class="title">
        <span class="water-color">
            <ArrowDown />
            @Math.Round(totalWater * 1000, 2) <span class="small">L</span>
        </span>
    </div>

    <h6>Water meter</h6>

    @if (isLoading)
    {
        <p>Loading...</p>
    }
    else
    {
        <EnergyChart Day="Day" GetChartPoints="GetChartPoints" MomentsPerView="momentsPerView" XLabelFormat="@labelFormat" />
    }
</div>

@code {

    private IEnumerable<DeviceWaterAggregate> chartData = [];
    private double totalWater;
    private bool isLoading = true;
    private DateTime to;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;

        try
        {
            if (Device is null)
            {
                chartData = [];
                totalWater = 0;
                return;
            }

            to = Day.Date == DateTime.Today
                ? DateTime.UtcNow
                : Day.AddDays(daysPerView);

            var chartDataTask = deviceRepository.GetDeviceWaterAggregates(Device.Id, Day, to, timeUnit);
            var totalWaterTask = deviceRepository.GetTotalWaterConsumed(Device.Id, Day, to);

            await Task.WhenAll(chartDataTask, totalWaterTask);

            chartData = await chartDataTask;
            totalWater = await totalWaterTask;
        }
        finally
        {
            isLoading = false;
        }
    }

    private ChartSeries[] GetChartPoints()
    {
        var startUnix = new DateTimeOffset(Day).ToUnixTimeSeconds();
        var endUnix = new DateTimeOffset(to).ToUnixTimeSeconds();

        var chartPoints = chartData
            .Where(x =>
                x.WaterConsumptionM3.HasValue &&
                x.IntervalStartUnix >= startUnix &&
                x.IntervalStartUnix < endUnix)
            .Select(x => new ChartPoint((x.IntervalStartUnix - startUnix) / timeUnit, x.WaterConsumptionM3!.Value * 1000, x.IntervalStartUnix))
            .OrderBy(x => x.Minute)
            .ToArray();

        var chartType = View == Views.Day ? ChartTypes.Line : ChartTypes.Bar;
        var series = new ChartSeries(chartType, chartPoints, "water");
        return [series];
    }
}

