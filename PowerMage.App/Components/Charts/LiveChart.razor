@using PowerMage.Api
@implements IDisposable
@inject DeviceRepository deviceRepository
@inject DeviceClient deviceClient

<div class="chartblock">
    <div class="title">
        @if (PowerWatts > 0)
        {
            <span class="import-color">
                <ArrowDown />
                Importing
            </span>
        }
        else
        {
            <span class="export-color">
                <ArrowUp />
                Exporting
            </span>
        }
        @if (isLoading || isLiveMode)
        {
            <span aria-busy="true" class="chart-loader"></span>
        }
    </div>

    @* Gauge *@

    <svg viewBox="0 30 480 320" role="img" aria-label="@($"Power: {PowerWatts:N0} W")" @onclick="SetLiveMode">
        <g class="power-meter-svg">
            <path class="gauge-track" d="M 80 210 A 160 160 0 0 1 400 210" />
            <path class="gauge-import" d="M 80 210 A 160 160 0 0 1 240 50" />
            <path class="gauge-export" d="M 240 50 A 160 160 0 0 1 400 210" />

            <g class="gauge-labels">
                <text x="240" y="30" text-anchor="middle">0 W</text>
                <text x="50" y="238" text-anchor="start">-5000 W</text>
                <text x="430" y="238" text-anchor="end">5000 W</text>
            </g>

            <g class="gauge-needle"
               style="@($"--needle-angle: {NeedleAngle.ToString(System.Globalization.CultureInfo.InvariantCulture)}deg")">
                <line x1="240" y1="210" x2="240" y2="75" />
                <circle cx="240" cy="210" r="10" />
            </g>

            <text class="@(PowerWatts > 0 ? "gauge-value import-color" : "gauge-value export-color")" x="240" y="270" text-anchor="middle">@PowerWatts.ToString("N0") W</text>
        </g>

        <g class="resource-gauge-svg water-gauge-svg">
            <circle class="resource-track" cx="100" cy="-20" r="45" />
            <circle class="resource-progress" cx="100" cy="-20" r="45" pathLength="100" style="@($"--gauge-progress: {GetGaugeProgress(WaterLitres, WaterMaxLitres)}")" />
            <text class="resource-value water-color" x="60" y="310" text-anchor="middle">@WaterLitres.ToString("N0") L</text>
        </g>

        <g class="resource-gauge-svg heat-gauge-svg">
            <circle class="resource-track" cx="100" cy="340" r="45" />
            <circle class="resource-progress" cx="100" cy="340" r="45" pathLength="100" style="@($"--gauge-progress: {GetGaugeProgress(HeatSquareMetres, HeatMaxSquareMetres)}")" />
            <text class="resource-value gas-color" x="420" y="310" text-anchor="middle">@HeatSquareMetres.ToString("N1") m3</text>
        </g>
    </svg>

</div>

@code {
    [Parameter]
    public DeviceModel? P1Device { get; set; }


    [Parameter]
    public DeviceModel? WaterDevice { get; set; }

    private readonly PeriodicTimer periodicTimer = new(TimeSpan.FromSeconds(60));
    private bool isLoading = true;
    private bool isLiveMode = false;

    private double PowerWatts { get; set; }

    private double NeedleAngle => Math.Clamp(PowerWatts / 5000.0, -1.0, 1.0) * 90.0;

    private double WaterLitres { get; set; } = 500;
    private double WaterMaxLitres { get; set; } = 1000;
    private double HeatSquareMetres { get; set; } = 10;
    private double HeatMaxSquareMetres { get; set; } = 20;

    private static string GetGaugeProgress(double value, double max)
    {
        if (max <= 0) return "0";
        return Math.Clamp(value / max * 100, 0, 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    }

    protected override void OnInitialized()
    {
        RunTimer();
    }

    protected override async Task OnParametersSetAsync()
    {
        await RefreshData();
    }

    protected async void RunTimer()
    {
        while (await periodicTimer.WaitForNextTickAsync())
        {
            await RefreshData();
        }
    }

    private async Task RefreshLiveData()
    {
        try
        {
            if (P1Device != null)
            {
                var measurement = await deviceClient.GetP1Measurement(P1Device);
                if (measurement != null)
                {
                    PowerWatts = measurement.ActivePowerW ?? 0;
                    // HeatSquareMetres = measurement.External?.FirstOrDefault()?.Value ?? 0;
                }
            }

            // if (WaterDevice != null)
            // {
            //     var measurement = await deviceClient.GetWaterMeasurement(WaterDevice);
            //     if (measurement != null)
            //     {
            //         WaterLitres = measurement.TotalLiterM3 ?? 0;
            //     }
            // }
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshData()
    {
        if (isLiveMode)
        {
            return;
        }

        try
        {
            if (P1Device != null)
            {
                PowerWatts = await deviceRepository.GetLatestActivePowerP1(P1Device.Id);
                HeatSquareMetres = await deviceRepository.GetTotalGasConsumed(P1Device.Id, DateTime.Today, DateTime.UtcNow);
            }

            if (WaterDevice != null)
            {
                WaterLitres = await deviceRepository.GetTotalWaterConsumed(WaterDevice.Id, DateTime.Today, DateTime.UtcNow);
            }
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        Dispose(true);
        GC.SuppressFinalize(this);
    }

    protected virtual void Dispose(bool disposing)
    {
        if (disposing)
        {
            periodicTimer.Dispose();
        }
    }

    private async void SetLiveMode()
    {
        isLiveMode = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var endTime = DateTime.UtcNow.AddSeconds(30);
            while (DateTime.UtcNow < endTime)
            {
                await RefreshLiveData();
                await Task.Delay(TimeSpan.FromSeconds(2));
            }
        }
        finally
        {
            isLiveMode = false;
            await InvokeAsync(StateHasChanged);
            await RefreshData();
        }
    }
}
