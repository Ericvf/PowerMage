@using System.Globalization

<div class="energy-chart">
    <div class="chart-plot">
        <svg class="energy-chart-svg" viewBox="0 0 1440 360" preserveAspectRatio="none" aria-hidden="true">
            <g class="grid">
                @if (YAxisStep > 0)
                {
                    @for (var watt = MinValue + YAxisStep; watt <= MaxValue; watt += YAxisStep)
                    {
                        var y = Math.Round(Y(watt));
                        <line x1="@ChartLeft" y1="@y" x2="@ChartRight" y2="@y" class="horizontal-grid" />
                    }
                }

                @for (var minute = 60; minute <= MinutesPerDay; minute += 60)
                {
                    var x = Math.Round(X(minute, MinutesPerDay));
                    <line x1="@x" y1="@ChartTop" x2="@x" y2="@ChartBottom" class="hour-grid" />
                }

                @if (MinValue < 0 && MaxValue >= 0)
                {
                    var y = Math.Round(Y(0));
                    <line x1="@ChartLeft" y1="@y"
                          x2="@ChartRight" y2="@y" class="zero-line" />
                }
            </g>

            <g class="data">
                <defs>
                    <linearGradient id="power-fill"
                                    x1="0"
                                    y1="0"
                                    x2="0"
                                    y2="1">
                        <stop offset="0%"
                              stop-color="var(--power-import)"
                              stop-opacity="0.75" />

                        <stop offset="100%"
                              stop-color="var(--power-import)"
                              stop-opacity="0.25" />
                    </linearGradient>
                    <linearGradient id="power-import-fill"
                                    x1="0"
                                    y1="1"
                                    x2="0"
                                    y2="0">
                        <stop offset="0%"
                              stop-color="var(--power-export)"
                              stop-opacity="0.75" />

                        <stop offset="100%"
                              stop-color="var(--power-export)"
                              stop-opacity="0.25" />
                    </linearGradient>
                    <linearGradient id="powerexport-fill"
                                    x1="0"
                                    y1="1"
                                    x2="0"
                                    y2="0">
                        <stop offset="0%"
                              stop-color="var(--power-export)"
                              stop-opacity="0.25" />

                        <stop offset="100%"
                              stop-color="var(--power-export)"
                              stop-opacity="0.75" />
                    </linearGradient>
                    <linearGradient id="gas-fill"
                                    x1="0"
                                    y1="0"
                                    x2="0"
                                    y2="1">
                        <stop offset="0%"
                              stop-color="var(--gas-color)"
                              stop-opacity="0.75" />

                        <stop offset="100%"
                              stop-color="var(--gas-color)"
                              stop-opacity="0.25" />
                    </linearGradient>
                    <linearGradient id="water-fill"
                                    x1="0"
                                    y1="0"
                                    x2="0"
                                    y2="1">
                        <stop offset="0%"
                              stop-color="var(--water-color)"
                              stop-opacity="0.75" />

                        <stop offset="100%"
                              stop-color="var(--water-color)"
                              stop-opacity="0.25" />
                    </linearGradient>
                </defs>
                    @if (chartSeries != null)
                    {

                        for (int i = 0; i < chartSeries.Length; i++)
                        {
                            var chartPoints = chartSeries[i].points;
                            var chartType = chartSeries[i].chartType;
                            var colorClass = chartSeries[i].colorClass;

                            if (chartType == ChartTypes.Line)
                            {
                                foreach (var segment in GetSegments(chartPoints))
                                {
                                    if (segment.Length >= 2)
                                    {
                                        var isNegative = segment.Any(x => x.Watts < 0);
                                        if (isNegative)
                                        {
                                            <path d="@BuildFilledPath(segment)" class="@($"{colorClass}-import-fill")" />
                                            <path d="@BuildSmoothPath(segment)" class="@($"chart-line {colorClass}-import-line")" />
                                        }
                                        else
                                        {
                                            <path d="@BuildFilledPath(segment)" class="@($"{colorClass}-fill")" />
                                            <path d="@BuildSmoothPath(segment)" class="@($"chart-line {colorClass}-line")" />
                                        }
                                    }
                                }

                                foreach (var point in chartPoints)
                                {
                                    var newValue = point.Watts < 0 ? MinValue : MaxValue;
                                    var tooltipColor = point.Watts < 0 ? $"powerexport" : colorClass;

                                    <path d="@InvisibleBarPath(new ChartPoint(point.Minute, newValue, point.title), i, chartSeries.Length, 1)" style="color:transparent"
                                      data-tooltip="@($"{F(point.Watts)} {chartSeries[i].suffix}")" data-tooltip-title="@($"{point.title}")" data-tooltip-color="@tooltipColor" />
                                }
                            }
                            else if (chartType == ChartTypes.Bar)
                            {
                                foreach (var point in chartPoints)
                                {
                                    if (point.Watts == 0)
                                        continue;

                                    <path d="@BuildBarPath(point, i, chartSeries.Length)"
                                        class="@($"{colorClass}-fill")"
                                        data-tooltip="@($"{F(point.Watts)} {chartSeries[i].suffix}")" data-tooltip-title="@($"{point.title}")" data-tooltip-color="@colorClass" />
                                }
                            }
                        }
                    }

               
            </g>

            <line class="axis" x1="@ChartLeft" y1="@ChartBottom" x2="@ChartRight" y2="@ChartBottom" />
            <line class="axis" x1="@ChartLeft" y1="@ChartTop" x2="@ChartLeft" y2="@ChartBottom" />

        </svg>
        <div class="x-labels">
            @foreach (var point in GetLabelPoints())
            {
                <span style="@($"left: {BarCenterPercentage(point.Minute).ToString("0.###", CultureInfo.InvariantCulture)}%")">
                    @UnixTimeStampToDateTime(point.title).ToString(XLabelFormat)
                </span>
            }
        </div>
    </div>
    <div class="y-labels">
        @if (YAxisStep > 0)
        {
            @for (double value = MinValue; value <= MaxValue; value += YAxisStep)
            {
                var percentage = ChartYPercentage(value);

                <span style="@($"top: {percentage.ToString("0.###", CultureInfo.InvariantCulture)}%")">
                    @FormatYAxisValue(value)
                </span>
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public DateTime Day { get; set; }

    [Parameter]
    public string XLabelFormat { get; set; } = "HH:mm";

    [Parameter]
    public Func<ChartSeries[]>? GetChartPoints { get; set; }

    private double MaxValue;
    private double MinValue;
    private ChartSeries[]? chartSeries;

    protected override async Task OnParametersSetAsync()
    {
        chartSeries = GetChartPoints?.Invoke() ?? Array.Empty<ChartSeries>();

        MaxValue = chartSeries?
            .Where(s => s.points != null)
            .SelectMany(s => s.points)
            .Select(p => p.Watts)
            .DefaultIfEmpty(0)
            .Max() ?? 0;
        MaxValue *= 1.1;

        MinValue = Math.Min(0, chartSeries?
         .Where(s => s.points != null)
         .SelectMany(s => s.points)
         .Select(p => p.Watts)
         .DefaultIfEmpty(0)
         .Min() ?? 0);
    }

    private double YAxisStep => (MaxValue - MinValue) / 10;

    private const int MinutesPerDay = 1440;

    [Parameter]
    public int MomentsPerView { get; set; } = 1440 / 5;

    private const double ChartLeft = 0;
    private const double ChartRight = 1425;
    private const double ChartTop = 15;
    private const double ChartBottom = 310;

    private double X(double minute, double total)
    {
        return ChartLeft + (minute / total) * (ChartRight - ChartLeft);
    }

    private double Y(double watts)
    {
        watts = Math.Clamp(watts, MinValue, MaxValue);

        return ChartBottom -
               ((watts - MinValue) / (MaxValue - MinValue)) *
               (ChartBottom - ChartTop);
    }

    private double ChartXPercentage(double minute, double total)
    {
        return X(minute, total) / 1440.0 * 100.0;
    }

    private double ChartYPercentage(double watts)
    {
        return Y(watts) / 360.0 * 100.0;
    }

    private string TimeLabel(int minute)
    {
        var time = TimeSpan.FromMinutes(minute);

        return $"{(int)time.TotalHours:00}:{time.Minutes:00}";
    }

    private List<ChartPoint[]> GetSegments(ChartPoint[] chartPoints)
    {
        if (!chartPoints.Any())
        {
            return new List<ChartPoint[]>();
        }

        var segments = new List<ChartPoint[]>();

        if (chartPoints.Length == 0)
            return segments;

        var current = new List<ChartPoint>();

        foreach (var point in chartPoints)
        {
            if (current.Count == 0)
            {
                current.Add(point);
                continue;
            }

            var previous = current[^1];

            var gap = point.Minute - previous.Minute > 5.01;
            if (gap)
            {
                segments.Add(current.ToArray());
                current = new List<ChartPoint> { point };
                continue;
            }

            var crossesZero = (previous.Watts < 0 && point.Watts > 0)
            || (previous.Watts > 0 && point.Watts < 0);

            if (crossesZero)
            {
                var fraction = -previous.Watts / (point.Watts - previous.Watts);
                var zeroMinute = previous.Minute + fraction * (point.Minute - previous.Minute);
                var zeroPoint = new ChartPoint(zeroMinute, 0, 0);

                current.Add(zeroPoint);
                segments.Add(current.ToArray());

                current = new List<ChartPoint>
                {
                    zeroPoint,
                    point
                };

                continue;
            }

            current.Add(point);
        }

        if (current.Count > 0)
            segments.Add(current.ToArray());

        return segments;
    }

    private string BuildFilledPath(ChartPoint[] points)
    {
        if (points.Length < 2)
            return string.Empty;

        var line = BuildSmoothPath(points);

        var firstX = X(points[0].Minute, MomentsPerView - 1);
        var lastX = X(points[^1].Minute, MomentsPerView - 1);

        // Zero line's Y-coordinate in the chart
        var zeroY = Y(0);

        return $"{line} " +
               $"L {F(lastX)} {F(zeroY)} " +
               $"L {F(firstX)} {F(zeroY)} Z";
    }

    private string BuildSmoothPath(ChartPoint[] points)
    {
        if (points.Length < 2)
            return string.Empty;


        var path = new System.Text.StringBuilder();


        var first = points[0];


        path.Append(
            $"M {F(X(first.Minute, MomentsPerView - 1))} {F(Y(first.Watts))}");


        for (var i = 0; i < points.Length - 1; i++)
        {
            var p0 = i > 0
                ? points[i - 1]
                : points[i];

            var p1 = points[i];

            var p2 = points[i + 1];

            var p3 = i + 2 < points.Length
                ? points[i + 2]
                : p2;

            /*
            * Catmull-Rom -> cubic Bézier.
             *
            * This gives us a smooth curve while keeping
            * the curve passing through the actual data points.
             */
            var cp1X =
                p1.Minute +
                (p2.Minute - p0.Minute) / 6.0;

            var cp1Y =
                p1.Watts +
                (p2.Watts - p0.Watts) / 6.0;


            var cp2X =
                p2.Minute -
                (p3.Minute - p1.Minute) / 6.0;

            var cp2Y =
                p2.Watts -
                (p3.Watts - p1.Watts) / 6.0;


            path.Append(
                $" C " +
                $"{F(X(cp1X, MomentsPerView - 1))} {F(Y(cp1Y))}, " +
                $"{F(X(cp2X, MomentsPerView - 1))} {F(Y(cp2Y))}, " +
                $"{F(X(p2.Minute, MomentsPerView - 1))} {F(Y(p2.Watts))}");
        }


        return path.ToString();
    }

    private string InvisibleBarPath(ChartPoint point, int seriesIndex, int seriesCount, double groupFill = 0.8)
    {
        if (MomentsPerView <= 0 || MaxValue <= MinValue)
            return string.Empty;

        var slotWidth = (ChartRight - ChartLeft) / MomentsPerView;
        var barWidth = slotWidth / seriesCount;
        var left = ChartLeft + point.Minute * barWidth;
        var right = left + barWidth;
        var top = ChartTop;
        var bottom = ChartBottom;

        return string.Join(" ",
            $"M {F(left)} {F(top)}",
            $"H {F(right)}",
            $"V {F(bottom)}",
            $"H {F(left)}",
            "Z");
    }

    private string BuildBarPath(ChartPoint point, int seriesIndex, int seriesCount, double groupFill = 0.8)
    {
        if (MomentsPerView <= 0 || MaxValue <= MinValue)
            return string.Empty;

        var slotWidth = (ChartRight - ChartLeft) / MomentsPerView;
        var groupWidth = slotWidth * groupFill;
        var barWidth = groupWidth / seriesCount;

        var slotCenter = ChartLeft + (point.Minute + 0.5) * slotWidth;
        var left = slotCenter - groupWidth / 2 + seriesIndex * barWidth;
        var right = left + barWidth;

        var zeroY = ChartBottom - (0 - MinValue) / (MaxValue - MinValue) * (ChartBottom - ChartTop);
        var valueY = ChartBottom - (point.Watts - MinValue) / (MaxValue - MinValue) * (ChartBottom - ChartTop);

        var top = Math.Min(zeroY, valueY);
        var bottom = Math.Max(zeroY, valueY);

        return string.Join(" ",
            $"M {F(left)} {F(top)}",
            $"H {F(right)}",
            $"V {F(bottom)}",
            $"H {F(left)}",
            "Z");
    }

    private double GetBarWidth()
    {
        return Math.Max(5, ((ChartRight - ChartLeft) / MomentsPerView));
    }

    private static string F(double value)
    {
        return value.ToString(
            "0.##",
            CultureInfo.InvariantCulture);
    }

    private string FormatYAxisValue(double value)
    {
        var step = Math.Abs(YAxisStep);

        if (step >= 100)
            return value.ToString("0", CultureInfo.InvariantCulture);

        if (step >= 10)
            return value.ToString("0.0", CultureInfo.InvariantCulture);

        if (step >= 1)
            return value.ToString("0.##", CultureInfo.InvariantCulture);

        if (step >= 0.1)
            return value.ToString("0.0", CultureInfo.InvariantCulture);

        if (step >= 0.01)
            return value.ToString("0.00", CultureInfo.InvariantCulture);

        if (step >= 0.001)
            return value.ToString("0.000", CultureInfo.InvariantCulture);

        if (step >= 0.0001)
            return value.ToString("0.0000", CultureInfo.InvariantCulture);

        return value.ToString("0.#####", CultureInfo.InvariantCulture);
    }

    private double BarCenterPercentage(double slotIndex)
    {
        var slotWidth = (ChartRight - ChartLeft) / MomentsPerView;
        var slotCenter = ChartLeft + (slotIndex + 0.5) * slotWidth;
        return slotCenter / 1440.0 * 100.0;
    }

    private IEnumerable<ChartPoint> GetLabelPoints()
    {
        if (chartSeries == null)
            return Enumerable.Empty<ChartPoint>();

        var maxLabels = Math.Min(MomentsPerView, 12);
        var step = Math.Max(1, (int)Math.Ceiling(MomentsPerView / (double)maxLabels));

        return chartSeries[0].points
            .Where(p => (int)p.Minute % step == 0)
            .GroupBy(p => (int)p.Minute)
            .Select(g => g.First())
            .OrderBy(p => p.Minute);
    }

    private static DateTime UnixTimeStampToDateTime(double unixTimeStamp)
    {
        DateTime dateTime = new DateTime(1970, 1, 1, 0, 0, 0, 0, DateTimeKind.Utc);
        dateTime = dateTime.AddSeconds(unixTimeStamp).ToLocalTime();
        return dateTime;
    }
}