@using System.Globalization

<div class="energy-chart">
    <div class="chart-plot">
        <svg class="energy-chart-svg" viewBox="0 0 1440 360" preserveAspectRatio="none" aria-hidden="true">
            <g class="grid">
                @if (YAxisStep > 0)
                {
                    @for (var watt = MinValue + YAxisStep; watt <= MaxValue; watt += YAxisStep)
                    {
                        var y = Math.Round(Y(watt));
                        <line x1="@ChartLeft" y1="@y" x2="@ChartRight" y2="@y" class="horizontal-grid" />
                    }
                }

                @for (var minute = 60; minute <= MinutesPerDay; minute += 60)
                {
                    var x = Math.Round(X(minute));
                    <line x1="@x" y1="@ChartTop" x2="@x" y2="@ChartBottom" class="hour-grid" />
                }

                @if (MinValue < 0 && MaxValue >= 0)
                {
                    var y = Math.Round(Y(0));
                    _ = y;
                    <line x1="@ChartLeft"
                          y1="@y"
                          x2="@ChartRight"
                          y2="@y"
                          class="zero-line" />
                }
            </g>

            <g class="data">
                <defs>
                    <linearGradient id="power-fill"
                                    x1="0"
                                    y1="0"
                                    x2="0"
                                    y2="1">
                        <stop offset="0%"
                              stop-color="var(--power-import)"
                              stop-opacity="0.75" />

                        <stop offset="100%"
                              stop-color="var(--power-import)"
                              stop-opacity="0.25" />
                    </linearGradient>
                    <linearGradient id="power-import-fill"
                                    x1="0"
                                    y1="1"
                                    x2="0"
                                    y2="0">
                        <stop offset="0%"
                              stop-color="var(--power-export)"
                              stop-opacity="0.75" />

                        <stop offset="100%"
                              stop-color="var(--power-export)"
                              stop-opacity="0.25" />
                    </linearGradient>
                    <linearGradient id="gas-fill"
                                    x1="0"
                                    y1="0"
                                    x2="0"
                                    y2="1">
                        <stop offset="0%"
                              stop-color="var(--gas-color)"
                              stop-opacity="0.75" />

                        <stop offset="100%"
                              stop-color="var(--gas-color)"
                              stop-opacity="0.25" />
                    </linearGradient>
                    <linearGradient id="water-fill"
                                    x1="0"
                                    y1="0"
                                    x2="0"
                                    y2="1">
                        <stop offset="0%"
                              stop-color="var(--water-color)"
                              stop-opacity="0.75" />

                        <stop offset="100%"
                              stop-color="var(--water-color)"
                              stop-opacity="0.25" />
                    </linearGradient>
                </defs>

                @foreach (var segment in GetSegments())
                {
                    if (segment.Count >= 2)
                    {
                        var isNegative = segment.Any(x => x.Watts < 0);

                        if (isNegative)
                        {
                            <path d="@BuildFilledPath(segment)" class="@($"{CssColorClass}-import-fill")" />
                            <path d="@BuildSmoothPath(segment)" class="@($"chart-line {CssColorClass}-import-line")" />
                        }
                        else
                        {
                            <path d="@BuildFilledPath(segment)" class="@($"{CssColorClass}-fill")" />
                            <path d="@BuildSmoothPath(segment)" class="@($"chart-line {CssColorClass}-line")" />
                        }
                    }
                }

            </g>

            <line class="axis" x1="@ChartLeft" y1="@ChartBottom" x2="@ChartRight" y2="@ChartBottom" />
            <line class="axis" x1="@ChartLeft" y1="@ChartTop" x2="@ChartLeft" y2="@ChartBottom" />

        </svg>

        <div class="x-labels">
            @for (var minute = 0; minute < MinutesPerDay; minute += 240)
            {
                var percentage = ChartXPercentage(minute);

                <span style="@($"left: {percentage.ToString("0.###", CultureInfo.InvariantCulture)}%")">
                    @TimeLabel(minute)
                </span>
            }
        </div>
    </div>
    <div class="y-labels">
        @if (YAxisStep > 0)
        {
            @for (double value = MinValue; value <= MaxValue; value += YAxisStep)
            {
                var percentage = ChartYPercentage(value);

                <span style="@($"top: {percentage.ToString("0.###", CultureInfo.InvariantCulture)}%")">
                    @FormatYAxisValue(value)
                </span>
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public DateTime Day { get; set; }

    [Parameter]
    public Func<List<ChartPoint>>? GetChartPoints { get; set; }

    [Parameter]
    public Func<double>? GetMaxValues { get; set; }

    [Parameter]
    public Func<double>? GetMinValues { get; set; }

    [Parameter]
    public string CssColorClass { get; set; } = "power";

    private double MaxValue => Math.Max(0, GetMaxValues?.Invoke() ?? 0d);

    private double MinValue => Math.Min(0, GetMinValues?.Invoke() ?? 0d);

    private double YAxisStep => (MaxValue - MinValue) / 10;

    private const int MinutesPerDay = 1440;
    private const double ChartLeft = 0;
    private const double ChartRight = 1425;
    private const double ChartTop = 15;
    private const double ChartBottom = 310;

    private double X(double minute)
    {
        return ChartLeft + (minute / MinutesPerDay) * (ChartRight - ChartLeft);
    }

    private double Y(double watts)
    {
        watts = Math.Clamp(watts, MinValue, MaxValue);

        return ChartBottom -
               ((watts - MinValue) / (MaxValue - MinValue)) *
               (ChartBottom - ChartTop);
    }

    private double ChartXPercentage(double minute)
    {
        return X(minute) / 1440.0 * 100.0;
    }

    private double ChartYPercentage(double watts)
    {
        return Y(watts) / 360.0 * 100.0;
    }

    private string TimeLabel(int minute)
    {
        var time = TimeSpan.FromMinutes(minute);

        return $"{(int)time.TotalHours:00}:{time.Minutes:00}";
    }

    private List<List<ChartPoint>> GetSegments()
    {
        if (GetChartPoints == null)
            return new List<List<ChartPoint>>();

        var points = GetChartPoints();

        if (!points.Any())
        {
            return new List<List<ChartPoint>>();
        }

        var segments = new List<List<ChartPoint>>();

        if (points.Count == 0)
            return segments;

        var current = new List<ChartPoint>();

        foreach (var point in points)
        {
            if (current.Count == 0)
            {
                current.Add(point);
                continue;
            }

            var previous = current[^1];

            var gap = point.Minute - previous.Minute > 5.01;
            if (gap)
            {
                segments.Add(current);
                current = new List<ChartPoint> { point };
                continue;
            }

            var crossesZero = (previous.Watts < 0 && point.Watts > 0)
            || (previous.Watts > 0 && point.Watts < 0);

            if (crossesZero)
            {
                var fraction = -previous.Watts / (point.Watts - previous.Watts);
                var zeroMinute = previous.Minute + fraction * (point.Minute - previous.Minute);
                var zeroPoint = new ChartPoint(zeroMinute, 0);

                current.Add(zeroPoint);
                segments.Add(current);

                current = new List<ChartPoint>
                {
                    zeroPoint,
                    point
                };

                continue;
            }

            current.Add(point);
        }

        if (current.Count > 0)
            segments.Add(current);

        return segments;
    }

    private string BuildFilledPath(List<ChartPoint> points)
    {
        if (points.Count < 2)
            return string.Empty;

        var line = BuildSmoothPath(points);

        var firstX = X(points[0].Minute);
        var lastX = X(points[^1].Minute);

        // Zero line's Y-coordinate in the chart
        var zeroY = Y(0);

        return $"{line} " +
               $"L {F(lastX)} {F(zeroY)} " +
               $"L {F(firstX)} {F(zeroY)} Z";
    }

    private string BuildSmoothPath(List<ChartPoint> points)
    {
        if (points.Count < 2)
            return string.Empty;


        var path = new System.Text.StringBuilder();


        var first = points[0];


        path.Append(
            $"M {F(X(first.Minute))} {F(Y(first.Watts))}");


        for (var i = 0; i < points.Count - 1; i++)
        {
            var p0 = i > 0
                ? points[i - 1]
                : points[i];

            var p1 = points[i];

            var p2 = points[i + 1];

            var p3 = i + 2 < points.Count
                ? points[i + 2]
                : p2;


            /*
             * Catmull-Rom -> cubic Bézier.
             *
             * This gives us a smooth curve while keeping
             * the curve passing through the actual data points.
             */
            var cp1X =
                p1.Minute +
                (p2.Minute - p0.Minute) / 6.0;

            var cp1Y =
                p1.Watts +
                (p2.Watts - p0.Watts) / 6.0;


            var cp2X =
                p2.Minute -
                (p3.Minute - p1.Minute) / 6.0;

            var cp2Y =
                p2.Watts -
                (p3.Watts - p1.Watts) / 6.0;


            path.Append(
                $" C " +
                $"{F(X(cp1X))} {F(Y(cp1Y))}, " +
                $"{F(X(cp2X))} {F(Y(cp2Y))}, " +
                $"{F(X(p2.Minute))} {F(Y(p2.Watts))}");
        }


        return path.ToString();
    }

    private static string F(double value)
    {
        return value.ToString(
            "0.##",
            CultureInfo.InvariantCulture);
    }

    private string FormatYAxisValue(double value)
    {
        var step = Math.Abs(YAxisStep);

        if (step >= 100)
            return value.ToString("0", CultureInfo.InvariantCulture);

        if (step >= 10)
            return value.ToString("0.0", CultureInfo.InvariantCulture);

        if (step >= 1)
            return value.ToString("0.##", CultureInfo.InvariantCulture);

        if (step >= 0.1)
            return value.ToString("0.0", CultureInfo.InvariantCulture);

        if (step >= 0.01)
            return value.ToString("0.00", CultureInfo.InvariantCulture);

        if (step >= 0.001)
            return value.ToString("0.000", CultureInfo.InvariantCulture);

        if (step >= 0.0001)
            return value.ToString("0.0000", CultureInfo.InvariantCulture);

        return value.ToString("0.#####", CultureInfo.InvariantCulture);
    }
}