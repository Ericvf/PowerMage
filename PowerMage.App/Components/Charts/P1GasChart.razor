@inject DeviceRepository deviceRepository

<div class="chartblock">
    <h4 class="gas-color">@Math.Round(totalGasM3, 2) m3</h4>
    <h6>Gas meter</h6>

    @if (IsLoading)
    {
        <p>Loading...</p>
    }
    else if (chartData.Count() == 0)
    {
        <p>No data found.</p>
    }
    else
    {
        <EnergyChart Day="Day" GetChartPoints="GetChartPoints" GetMaxValues="GetMaxGasConsumption" CssColorClass="gas" />
    }
</div>

@code {
    [Parameter]
    public DateTime Day { get; set; }

    [Parameter]
    public DeviceModel? Device { get; set; }

    private IEnumerable<DeviceP1GasAggregate> chartData = [];
    private double totalGasM3 = 0;
    private bool IsLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (Device == null)
                return;

            var now = DateTime.UtcNow;
            var today = now.Date;

            var chartDataTask = deviceRepository.GetDeviceP1GasAggregates(Device.Id, today, now);
            var totalGasM3Task = deviceRepository.GetTotalGasConsumed(Device.Id, today, now);

            await Task.WhenAll(chartDataTask, totalGasM3Task);

            chartData = chartDataTask.Result;
            totalGasM3 = totalGasM3Task.Result;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private List<ChartPoint> GetChartPoints()
    {
        var dayStartUnix = new DateTimeOffset(Day).ToUnixTimeSeconds();
        var dayEndUnix = dayStartUnix + 86400;

        var points = chartData
            .Where(x =>
                x.GasConsumptionM3.HasValue &&
                x.IntervalStartUnix >= dayStartUnix &&
                x.IntervalStartUnix < dayEndUnix)

            .Select(x =>
            {
                var minute =
                    (x.IntervalStartUnix - dayStartUnix) / 60.0;

                return new ChartPoint(minute, x.GasConsumptionM3!.Value);
            })
            .OrderBy(x => x.Minute)
            .ToList();

        return points;
    }

    private double GetMaxGasConsumption()
    {
        return chartData.Where(x => x.GasConsumptionM3.HasValue)
            .Select(x => x.GasConsumptionM3!.Value)
            .DefaultIfEmpty(0)
            .Max();
    }
}
