@inherits ChartBase
@inject DeviceRepository deviceRepository

<div class="chartblock">
    <div class="title">
        <span class="gas-color">
            <ArrowDown />
            @Math.Round(totalGasM3, 2) <span class="small">m3</span>
        </span>
    </div>

    <h6>Gas meter</h6>
    @if (isLoading)
    {
        <p>Loading...</p>
    }
    else
    {
        <EnergyChart Day="Day" GetChartPoints="GetChartPoints" MomentsPerView="momentsPerView" XLabelFormat="@labelFormat" />
    }
</div>

@code {
    private IEnumerable<DeviceP1GasAggregate> chartData = [];
    private double totalGasM3 = 0;
    private bool isLoading = true;
    private DateTime to;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;

        try
        {
            if (Device is null)
            {
                chartData = [];
                totalGasM3 = 0;
                return;
            }

            to = Day.Date == DateTime.Today
                ? DateTime.UtcNow
                : Day.AddDays(daysPerView);

            var chartDataTask = deviceRepository.GetDeviceP1GasAggregates(Device.Id, Day, to, timeUnit);
            var totalGasM3Task = deviceRepository.GetTotalGasConsumed(Device.Id, Day, to);

            await Task.WhenAll(chartDataTask, totalGasM3Task);

            chartData = await chartDataTask;
            totalGasM3 = await totalGasM3Task;
        }
        finally
        {
            isLoading = false;
        }
    }

    private ChartSeries[] GetChartPoints()
    {
        var startUnix = new DateTimeOffset(Day).ToUnixTimeSeconds();
        var endUnix = new DateTimeOffset(to).ToUnixTimeSeconds();

        var chartPoints = chartData
            .Where(x =>
                x.GasConsumptionM3.HasValue &&
                x.IntervalStartUnix >= startUnix &&
                x.IntervalStartUnix < endUnix)
            .Select(x => new ChartPoint((x.IntervalStartUnix - startUnix) / timeUnit, x.GasConsumptionM3!.Value, x.IntervalStartUnix))
            .OrderBy(x => x.Minute)
            .ToArray();

        var chartType = View == Views.Day ? ChartTypes.Line : ChartTypes.Bar;
        var series = new ChartSeries(chartType, chartPoints, "gas", "m3");
        return [series];
    }
}
