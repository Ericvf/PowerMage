@page "/"
@using PowerMage.Components.Charts
@inject DeviceRepository deviceRepository

<header style="display: flex; align-items: center;">
    <button class="secondary outline"><small>➕ Add device</small></button>
    <h2>Power Mage⚡️</h2>
</header>

<PageTitle>PowerMage⚡ - Dashboard</PageTitle>

@if (IsLoading)
{
    <p>Loading...</p>
}
else if (!Devices.Any())
{
    <main class="container">
        <article>
            <h2>Welcome to Power Mage ⚡</h2>
            <p>It appears you have not added any devices yet. Use the button above to add devices to Power Mage.</p>
        </article>
    </main>

  
}
else
{
    @foreach (var device in Devices)
    {
        if (device.ProductType == "HWE-SKT")
        {
            <SKTChart Day="@Today" Device="@device" />
        }
        else if (device.ProductType == "HWE-P1")
        {
            <P1Chart Day="@Today" Device="@device" />
            <P1GasChart Day="@Today" Device="@device" />
        }
        else if (device.ProductType == "HWE-WTR")
        {
            <WaterChart Day="@Today" Device="@device" />
        }
    }
}

<footer>
    <img src="/appbyfex.png" />
</footer>

@code {
    private DateTime Today = DateTime.Today;
    private bool IsLoading = true;

    private IEnumerable<DeviceModel> Devices = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Devices = await deviceRepository.GetDevices()
                .ContinueWith(t => t.Result.Where(r => r.Track == 1));
        }
        finally
        {
            IsLoading = false;
        }
    }
}